[Unit]
Description=Reboot system if internet connectivity is lost
After=network-online.target lte-ecm.service
Wants=network-online.target lte-ecm.service

[Service]
Type=simple
ExecStart=/projects/modem/internet-watchdog.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
